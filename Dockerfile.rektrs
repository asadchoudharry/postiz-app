# Isolated REKTRS build. Never replace Dokploy's live image before
# encrypted DB/media/config backups, restore and staging acceptance.
# Upstream source match: gitroomhq/postiz-app 8e42f09cb45c3b6be16656c2d23a372d5eb21053.
FROM node:22.23.4-bookworm-slim

ARG NEXT_PUBLIC_VERSION
ARG REKTRS_SOURCE_REVISION
ARG NEXT_PUBLIC_REKTRS_SOCIAL_BRAND=false
ARG NEXT_PUBLIC_REKTRS_CONTENT_REVIEW=false
RUN test -n "$REKTRS_SOURCE_REVISION"

ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION \
    NEXT_PUBLIC_REKTRS_SOCIAL_BRAND=$NEXT_PUBLIC_REKTRS_SOCIAL_BRAND \
    NEXT_PUBLIC_REKTRS_CONTENT_REVIEW=$NEXT_PUBLIC_REKTRS_CONTENT_REVIEW

LABEL org.opencontainers.image.source="https://github.com/asadchoudharry/postiz-app" \
      org.opencontainers.image.revision="$REKTRS_SOURCE_REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3-pip bash nginx \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Source distribution retains AGPL notices in the upstream repository.
# No automatic prisma db push, schema migration or worker replay.
CMD ["sh", "/app/scripts/rektrs-social-start.sh"]
